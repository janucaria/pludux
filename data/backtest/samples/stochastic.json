{
  "version": 2,
  "series": {
    "stoch": {
      "method": "STOCH",
      "params": {
        "kPeriod": {
          "method": "INPUT",
          "params": {
            "label": "K Period",
            "representation": "UnsignedInteger",
            "value": 14
          }
        },
        "kSmooth": {
          "method": "INPUT",
          "params": {
            "label": "K Smooth",
            "representation": "UnsignedInteger",
            "value": 3
          }
        },
        "dPeriod": {
          "method": "INPUT",
          "params": {
            "label": "D Period",
            "representation": "UnsignedInteger",
            "value": 3
          }
        }
      }
    },
    "stoch_k": {
      "method": "SELECT_OUTPUT",
      "params": {
        "output": "k-percent",
        "source": {
          "method": "SERIES_NODE",
          "params": {
            "name": "stoch"
          }
        }
      }
    },
    "stoch_d": {
      "method": "SELECT_OUTPUT",
      "params": {
        "output": "d-percent",
        "source": {
          "method": "SERIES_NODE",
          "params": {
            "name": "stoch"
          }
        }
      }
    },
    "overbought": {
      "method": "INPUT",
      "params": {
        "label": "Overbought",
        "representation": "Decimal",
        "value": 80
      }
    },
    "oversold": {
      "method": "INPUT",
      "params": {
        "label": "Oversold",
        "representation": "Decimal",
        "value": 20
      }
    }
  },
  "positions": {
    "long": {
      "entry": {
        "signalDelay": 1,
        "price": "OPEN",
        "signal": {
          "method": "ALL_OF",
          "params": {
            "items": [
              {
                "method": "CROSSOVER",
                "params": {
                  "value": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "stoch_k"
                    }
                  },
                  "baseline": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "stoch_d"
                    }
                  }
                }
              },
              {
                "method": "LESS_THAN",
                "params": {
                  "target": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "stoch_k"
                    }
                  },
                  "threshold": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "oversold"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "exit": {
        "signalDelay": 1,
        "price": "OPEN",
        "signal": {
          "method": "ALL_OF",
          "params": {
            "items": [
              {
                "method": "CROSSUNDER",
                "params": {
                  "value": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "stoch_k"
                    }
                  },
                  "baseline": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "stoch_d"
                    }
                  }
                }
              },
              {
                "method": "GREATER_THAN",
                "params": {
                  "target": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "stoch_k"
                    }
                  },
                  "threshold": {
                    "method": "SERIES_VALUE",
                    "params": {
                      "name": "overbought"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "stopLoss": {
        "enabled": true,
        "trailing": false,
        "stopPrice": {
          "method": "SUBTRACT",
          "params": {
            "minuend": "OPEN",
            "subtrahend": {
              "method": "PERCENTAGE",
              "params": {
                "base": "OPEN",
                "percent": 10
              }
            }
          }
        }
      },
      "takeProfit": {
        "enabled": true,
        "targetPrice": {
          "method": "ADD",
          "params": {
            "augend": "OPEN",
            "addend": {
              "method": "PERCENTAGE",
              "params": {
                "base": "OPEN",
                "percent": 20
              }
            }
          }
        }
      }
    }
  },
  "plots": [
    {
      "label": "Stoch",
      "overlay": false,
      "items": [
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "stoch_k"
              }
            },
            "color": "yellow"
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "stoch_d"
              }
            },
            "color": "cyan"
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "overbought"
              }
            },
            "color": "#FFFFFF"
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "oversold"
              }
            },
            "color": "#FFFFFF"
          }
        }
      ]
    }
  ]
}

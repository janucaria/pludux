{
  "version": 1,
  "series": {
    "market_close": {
      "method": "EXTERN.FIELD",
      "params": { "reference": "market", "field": "CLOSE" }
    }
  },
  "positions": {
    "long": {
      "entry": {
        "price": { "method": "MARKET_DATA.CLOSE" },
        "delay": 0,
        "priceExitsStart": "NEXT_BAR",
        "signal": {
          "method": "COMPARISON.GREATER_THAN",
          "params": {
            "target": {
              "method": "SERIES.REFERENCE",
              "params": { "name": "market_close" }
            },
            "threshold": 7000
          }
        }
      },
      "riskDistance": {
        "method": "RISK_DISTANCE.AMOUNT",
        "params": { "amount": 100 }
      }
    },
    "short": false
  }
}

{
  "version": 2,
  "series": {
    "stoch_rsi": {
      "method": "STOCH_RSI",
      "params": {
        "kPeriod": {
          "method": "INPUT",
          "params": {
            "label": "K Period",
            "representation": "UnsignedInteger",
            "value": 14
          }
        },
        "kSmooth": {
          "method": "INPUT",
          "params": {
            "label": "K Smooth",
            "representation": "UnsignedInteger",
            "value": 3
          }
        },
        "dPeriod": {
          "method": "INPUT",
          "params": {
            "label": "D Period",
            "representation": "UnsignedInteger",
            "value": 3
          }
        },
        "rsiSource": "CLOSE",
        "rsiPeriod": {
          "method": "INPUT",
          "params": {
            "label": "RSI Period",
            "representation": "UnsignedInteger",
            "value": 14
          }
        }
      }
    },
    "stoch_rsi_k": {
      "method": "SELECT_OUTPUT",
      "params": {
        "output": "k-percent",
        "source": {
          "method": "SERIES",
          "params": {
            "name": "stoch_rsi"
          }
        }
      }
    },
    "stoch_rsi_d": {
      "method": "SELECT_OUTPUT",
      "params": {
        "output": "d-percent",
        "source": {
          "method": "SERIES",
          "params": {
            "name": "stoch_rsi"
          }
        }
      }
    },
    "overbought": {
      "method": "INPUT",
      "params": {
        "label": "Overbought",
        "representation": "Decimal",
        "value": 80
      }
    },
    "oversold": {
      "method": "INPUT",
      "params": {
        "label": "Oversold",
        "representation": "Decimal",
        "value": 20
      }
    }
  },
  "positions": {
    "long": {
      "entry": {
        "signalDelay": 1,
        "price": "OPEN",
        "signal": {
          "method": "ALL_OF",
          "params": {
            "items": [
              {
                "method": "CROSSOVER",
                "params": {
                  "value": {
                    "method": "SERIES",
                    "params": {
                      "name": "stoch_rsi_k"
                    }
                  },
                  "baseline": {
                    "method": "SERIES",
                    "params": {
                      "name": "stoch_rsi_d"
                    }
                  }
                }
              },
              {
                "method": "LESS_THAN",
                "params": {
                  "target": {
                    "method": "SERIES",
                    "params": {
                      "name": "stoch_rsi_k"
                    }
                  },
                  "threshold": {
                    "method": "SERIES",
                    "params": {
                      "name": "oversold"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "exits": [
        {
          "enabled": true,
          "signalDelay": 1,
          "price": "OPEN",
          "signal": {
            "method": "ALL_OF",
            "params": {
              "items": [
                {
                  "method": "CROSSUNDER",
                  "params": {
                    "value": {
                      "method": "SERIES",
                      "params": {
                        "name": "stoch_rsi_k"
                      }
                    },
                    "baseline": {
                      "method": "SERIES",
                      "params": {
                        "name": "stoch_rsi_d"
                      }
                    }
                  }
                },
                {
                  "method": "GREATER_THAN",
                  "params": {
                    "target": {
                      "method": "SERIES",
                      "params": {
                        "name": "stoch_rsi_k"
                      }
                    },
                    "threshold": {
                      "method": "SERIES",
                      "params": {
                        "name": "overbought"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "stopLoss": {
        "enabled": true,
        "trailing": false,
        "stopPrice": {
          "method": "SL_ATR",
          "params": {
            "period": {
              "method": "VALUE",
              "params": {
                "value": 14
              }
            },
            "multiplier": {
              "method": "VALUE",
              "params": {
                "value": 2
              }
            },
            "maSmoothingType": "RMA"
          }
        }
      },
      "takeProfits": [
        {
          "enabled": true,
          "targetPrice": {
            "method": "TP_R_MULTIPLE",
            "params": {
              "multiple": {
                "method": "VALUE",
                "params": {
                  "value": 2
                }
              }
            }
          }
        }
      ]
    }
  },
  "plots": [
    {
      "label": "Stoch RSI",
      "overlay": false,
      "items": [
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "stoch_rsi_k"
              }
            },
            "color": "yellow"
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "stoch_rsi_d"
              }
            },
            "color": "cyan"
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "overbought"
              }
            },
            "color": "#FFFFFF"
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "oversold"
              }
            },
            "color": "#FFFFFF"
          }
        }
      ]
    }
  ]
}

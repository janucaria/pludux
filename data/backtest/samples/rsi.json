{
  "version": 2,
  "series": {
    "rsi": {
      "method": "RSI",
      "params": {
        "period": {
          "method": "INPUT",
          "params": {
            "label": "RSI Period",
            "representation": "UnsignedInteger",
            "value": 14
          }
        }
      }
    },
    "overbought": {
      "method": "INPUT",
      "params": {
        "label": "Overbought",
        "representation": "Decimal",
        "value": 70
      }
    },
    "oversold": {
      "method": "INPUT",
      "params": {
        "label": "Oversold",
        "representation": "Decimal",
        "value": 30
      }
    }
  },
  "stopLoss": {
    "enabled": false
  },
  "takeProfit": {
    "enabled": true,
    "rMultiple": 3
  },
  "positions": {
    "long": {
      "entry": {
        "signal": {
          "method": "CROSSUNDER",
          "params": {
            "value": {
              "method": "SERIES_VALUE",
              "params": {
                "name": "rsi"
              }
            },
            "baseline": {
              "method": "SERIES_VALUE",
              "params": {
                "name": "oversold"
              }
            }
          }
        }
      },
      "exit": {
        "signal": {
          "method": "CROSSOVER",
          "params": {
            "value": {
              "method": "SERIES_VALUE",
              "params": {
                "name": "rsi"
              }
            },
            "baseline": {
              "method": "SERIES_VALUE",
              "params": {
                "name": "overbought"
              }
            }
          }
        }
      }
    }
  },
  "plots": [
    {
      "label": "RSI",
      "overlay": false,
      "items": [
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "rsi"
              }
            },
            "color": 4278190079
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "oversold"
              }
            },
            "color": 4278190079
          }
        },
        {
          "method": "LINE",
          "params": {
            "source": {
              "method": "SERIES",
              "params": {
                "name": "overbought"
              }
            },
            "color": 4278190079
          }
        }
      ]
    }
  ]
}